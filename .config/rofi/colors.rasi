* {
    background: rgba(13, 18, 9, 0.85);
    primary: #7da568;
    primary-fixed: #96bd82;
    primary-fixed-dim: #7da568;
    on-primary: #0a1506;
    on-primary-fixed: #001200;
    on-primary-fixed-variant: #1a3012;
    primary-container: #1a3012;
    on-primary-container: #96bd82;
    secondary: #c4d4b8;
    secondary-fixed: #d6e6ca;
    secondary-fixed-dim: #c4d4b8;
    on-secondary: #1a2812;
    on-secondary-fixed: #0e1a08;
    on-secondary-fixed-variant: #2d4a22;
    secondary-container: #2d4a22;
    on-secondary-container: #d6e6ca;
    tertiary: #8ab8a8;
    tertiary-fixed: #a2ccbc;
    tertiary-fixed-dim: #8ab8a8;
    on-tertiary: #002820;
    on-tertiary-fixed: #001812;
    on-tertiary-fixed-variant: #153d32;
    tertiary-container: #153d32;
    on-tertiary-container: #a2ccbc;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0d1209;
    on-surface: #dce3d4;
    on-surface-variant: #c0cbb5;
    outline: #8a9478;
    outline-variant: #334228;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dce3d4;
    inverse-on-surface: #252e20;
    inverse-primary: #2d5a1a;
    surface-dim: #0d1209;
    surface-bright: #2d3a24;
    surface-container-lowest: #080c06;
    surface-container-low: #121a0e;
    surface-container: #161f12;
    surface-container-high: #202a1a;
    surface-container-highest: #2b3624;
}