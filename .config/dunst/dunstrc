[global]
    monitor = 0
    follow = mouse
    width = 360
    height = (0, 180)
    origin = top-right
    offset = (12, 12)
    scale = 0

    font = UbuntuMono Nerd Font 12
    markup = full
    format = <b>%s</b>\n%b
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    separator_height = 0
    corner_radius = 12
    transparency = 20
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    show_indicators = yes
    icon_position = left
    min_icon_size = 48
    max_icon_size = 48
    enable_recursive_icon_lookup = true

    history_length = 20
    sticky_history = yes
    stack_duplicates = true
    hide_duplicate_count = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a2812"
    foreground = "#b8c9a8"
    frame_color = "#3d5a2e"
    highlight = "#7da568"
    timeout = 4

[urgency_normal]
    background = "#0d1209"
    foreground = "#d4e6c3"
    frame_color = "#7da568"
    highlight = "#8fb87a"
    timeout = 6

[urgency_critical]
    background = "#0d1209"
    foreground = "#d4e6c3"
    frame_color = "#c47a6a"
    highlight = "#c47a6a"
    timeout = 0
